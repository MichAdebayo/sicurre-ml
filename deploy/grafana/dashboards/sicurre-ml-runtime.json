        {
          "type": "timeseries",
          "title": "ML handler latency by requested mode",
          "description": "p95 split by the mode the caller requested. mode=llm includes the provider chain, bounded in production by LLM_TOTAL_TIMEOUT_SECONDS=7.5s with LLM_PROVIDER_TIMEOUT_SECONDS=4.5s per provider; mode=local skips it. The 3000 ms histogram ceiling applies here too, so llm-mode p95 saturates before the chain budget is reached.",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "gridPos": {
            "x": 0,
            "y": 8,
            "w": 24,
            "h": 8
