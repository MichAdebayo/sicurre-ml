{
  "annotations": {
    "list": []
  },
  "description": "Operational view of the Sicurre ML inference service. Latency shown is time inside the ML classify handler, not end-to-end email delivery. The first screen is sized for a 1440x900 capture; detail is grouped below in collapsed sections.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Model ready",
      "description": "1 when the ONNX session is loaded and the service answers readiness. No data means the scrape itself is missing, which is not the same as unhealthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "valueSize": 22
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not ready",
                  "index": 1
                },
                "1": {
                  "text": "Ready",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sicurre_model_ready{stack=\"sicurre-ml\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active model revision",
      "description": "Immutable Hugging Face revision of the served model, truncated for display as first ten and last eight characters. The metric's version label carries the SHA rather than the semantic version; deployment-identity documentation maps the two.",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 7,
        "h": 3
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "valueSize": 13
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "custom": {}
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (display_version) (label_replace(sicurre_inference_model_info{stack=\"sicurre-ml\",version=~\".{19,}\"}, \"display_version\", \"$1\u2026$2\", \"version\", \"^(.{10}).*(.{8})$\")) or max by (display_version) (label_replace(sicurre_inference_model_info{stack=\"sicurre-ml\",version=~\".{0,18}\"}, \"display_version\", \"$1\", \"version\", \"^(.*)$\"))",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Requests in range",
      "description": "Classify requests over the selected time range, calculated independently of the rolling windows used by the rate chart. Prometheus increases are estimates, not an authoritative request ledger.",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "gridPos": {
        "x": 11,
        "y": 0,
        "w": 5,
        "h": 3
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "valueSize": 28
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(sicurre_inference_requests_total{stack=\"sicurre-ml\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Non-2xx responses",
      "description": "Requests answered with a non-2xx status over the selected range. Displayed as an absolute count so that zero is distinguishable from absent telemetry.",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "valueSize": 28
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(sicurre_inference_request_status_total{stack=\"sicurre-ml\",status_code!~\"2..\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Degraded decisions",
      "description": "Requests that returned a verdict with a degradation reason recorded, typically the LLM provider chain being unavailable. A degraded answer is still an answer. No substitution to zero: an absent series reads 'No data', because never-incremented and measured-zero are different states.",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "valueSize": 28
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(sicurre_inference_degradation_total{stack=\"sicurre-ml\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "ML handler latency percentiles \u2014 all modes",
      "description": "Time spent inside the ML classify handler, not end-to-end email delivery. Estimated from a classic histogram whose boundaries run 50 ms to 3000 ms; a quantile landing in the overflow bucket reports 3000 ms and cannot exceed it. Percentiles from a handful of requests are unstable; read them beside the request count.",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 14,
        "h": 7
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": false,
            "insertNulls": true,
            "axisLabel": "",
            "gradientMode": "none",
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(sicurre_inference_request_latency_ms_bucket{stack=\"sicurre-ml\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "interval": "1m"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sicurre_inference_request_latency_ms_bucket{stack=\"sicurre-ml\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "interval": "1m"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate",
      "description": "Classify requests per minute, derived from a rolling window of at least two scrapes at the 60-second cadence. This is a smoothed rate, not a count of events in a bin; the range total is shown separately in the summary strip.",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "gridPos": {
        "x": 14,
        "y": 3,
        "w": 10,
        "h": 7
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": false,
            "insertNulls": true,
            "axisLabel": "",
            "gradientMode": "none",
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(sicurre_inference_requests_total{stack=\"sicurre-ml\"}[$__rate_interval])) * 60",
          "legendFormat": "requests/min",
          "refId": "A",
          "interval": "1m"
        }
      ]
    },
    {
